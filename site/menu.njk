---
layout: base.njk
pagination:
  data: catalogue.entries
  size: 1
  alias: e
permalink: "menus/{{ e.menuId }}/index.html"
---
<article data-pagefind-body>
  <p class="crumbs"><a href="{{ '/menus/' | url }}">Browse</a> /</p>
  <div class="menuhead">
    <div>
      <h1 data-pagefind-meta="title">{{ e.title }}</h1>
      <p class="disc">{{ 'Movie' if e.kind == 'movie' else 'Series' }}{% if e.discLine %} · {{ e.discLine }}{% endif %}{% if e.originalTitle %} · {{ e.originalTitle }}{% endif %}</p>
    </div>
    <p class="actions">
      <a class="button" href="{{ e.url | url }}" download="{{ e.menuId }}.menu.json">Download menu</a>
      <a class="button ghost" href="{{ e.url | url }}">Raw JSON</a>
    </p>
  </div>
  <p class="menudesc">{{ e.description }}</p>
  <p class="chips">
    {% if e.demo %}<span class="chip">Demonstration</span>{% endif %}
    {% for b in e.badges %}<span class="chip {{ b.kind }}">{{ b.label }}</span>{% endfor %}
    {% for t in e.tags %}<span class="chip tag" data-pagefind-filter="tag">{{ t }}</span>{% endfor %}
  </p>

  <section id="preview" class="preview" data-menu="{{ e.url }}" data-pagefind-ignore>
    <div id="preview-stage" class="stage">
      <img class="poster" src="{{ ('/' + e.thumb) | url }}" alt="Preview of the {{ e.title }} menu" width="1280" height="720" data-pagefind-meta="image[src]">
      <iframe id="preview-frame" title="Interactive preview of the menu" tabindex="0"></iframe>
    </div>
    <p class="muted small">A <strong>layout preview</strong> with generated placeholder pictures: your server supplies the real backgrounds, and playing is switched off.
    Use the mouse, or <button type="button" id="preview-focus" class="linkish">click here</button> and then the arrow keys, Enter and Escape.</p>
    <p class="controls">
      <span class="label">Preview</span>
      <button type="button" id="preview-mute" aria-pressed="false">Sound: off</button>
      {% for s in e.screens %}<button type="button" data-screen="{{ s.key }}">{{ s.title }}</button>{% endfor %}
    </p>
    {% if "tmdb" in e.backgrounds %}
    <p class="small"><label><input type="checkbox" id="preview-tmdb"> Show the film's real TMDB backdrop. This loads images from image.tmdb.org, which can then see your address.</label></p>
    {% endif %}
    <p id="preview-status" class="muted small" aria-live="polite"></p>
  </section>
  <script src="{{ '/assets/harness-core.js' | url }}"></script>
  <script src="{{ '/assets/vendor/menu-to-renderable.js' | url }}"></script>
  <script src="{{ '/assets/menu-preview.js' | url }}"></script>

  {% if e.needsLocalArt.length %}
  <aside class="notice">
    <h2>Bring your own art</h2>
    <p>This menu refers to picture or sound files that the catalogue does not host. Put files with these names in
    <code>assets/{{ e.menuId }}/</code> inside your menus folder:</p>
    <ul>{% for a in e.needsLocalArt %}<li><code>{{ a | replace('asset:' + e.menuId + '/', '') }}</code></li>{% endfor %}</ul>
    <p>Without them the menu still works; those parts just show nothing.</p>
  </aside>
  {% endif %}

  <div class="cols">
    <section>
      <h2>What's in it</h2>
      <ul class="screens">
      {% for s in e.screens %}
        <li><strong>{{ s.title }}</strong>{% if s.labels.length %}<span>{{ s.labels | join(' · ') }}</span>{% endif %}</li>
      {% endfor %}
      </ul>
    </section>
    <section>
      <h2>Details</h2>
      <dl class="facts">
        <dt>Author</dt><dd>{% if e.author.github %}<a href="{{ ('https://github.com/' + e.author.github) }}">{{ e.author.name }}</a>{% else %}{{ e.author.name }}{% endif %}</dd>
        <dt>Licence</dt><dd>CC0 1.0 (public domain)</dd>
        <dt>Revision</dt><dd>{{ e.revision }}</dd>
        <dt>Needs plugin</dt><dd>{{ e.minPluginVersion }} or later</dd>
        {% if e.language %}<dt>Language</dt><dd>{{ e.language }}</dd>{% endif %}
        {% if e.releaseLine %}<dt>For release</dt><dd>{{ e.releaseLine }}</dd>{% endif %}
        <dt>Matches</dt><dd>{% for i in e.ids %}<code>{{ i.name }} {{ i.value }}</code> {% endfor %}{% if e.tmdbUrl %}<a href="{{ e.tmdbUrl }}">on TMDB</a>{% endif %}</dd>
        <dt>File</dt><dd>{{ e.size }} bytes · sha256 <code class="hash">{{ e.sha256 }}</code></dd>
      </dl>
    </section>
  </div>

  {% if e.changelog %}
  <h2>Changes</h2>
  <ul class="changes">{% for c in e.changelog %}<li><strong>Revision {{ c.revision }}</strong> ({{ c.date }}): {{ c.notes }}</li>{% endfor %}</ul>
  {% endif %}

  <h2>Use it</h2>
  <ol>
    <li>Download the file above and copy it into the plugin's menus folder (or install it from the plugin's <strong>Menu Catalogue</strong> page).</li>
    <li>Make sure the title with the matching id is in your Jellyfin library. The plugin finds it by those ids.</li>
    <li>Open the title and press <em>Disc Menu</em>. The <strong>Menu Files</strong> table on the plugin's dashboard page shows how it matched.</li>
  </ol>
  <p><a href="{{ e.sourceUrl }}">Source on GitHub</a> · <a href="{{ e.historyUrl }}">Earlier revisions</a></p>

  <details>
    <summary>Show the JSON</summary>
    <pre class="json"><code>{{ e.raw }}</code></pre>
  </details>
</article>
